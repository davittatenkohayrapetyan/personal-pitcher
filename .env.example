# LLM_PROVIDER is no longer used by the default provider. The chain is now
#   tier 0  Mac Ollama (MAC_OLLAMA_* below, opt-in)
#   tier 1  OpenAI (when OPENAI_API_KEY is set)
#   tier 2  local Ollama
#   tier 3  regex intent classifier (classification only)
# This variable is kept for reference; createLLMProvider() still accepts it for
# direct single-provider usage if needed.
# LLM_PROVIDER=ollama

# ─── Tier 0: Ollama on a Mac on the LAN ──────────────────────────────────────
# Opt-in. Leave MAC_OLLAMA_BASE_URL unset (the default) and the tier does not
# exist — the chain is exactly OpenAI -> Ollama as before. Set it to run a big
# local model for free whenever that machine happens to be awake and at home.
#
# This tier is designed around being *routinely absent*. It is gated behind a
# short reachability probe and its own circuit breaker, so a Mac that is asleep
# or on another network costs one sub-second probe rather than a ~20s TCP stall
# (an absent host drops packets silently; it does not refuse the connection).
# MAC_OLLAMA_BASE_URL=http://192.168.1.50:11434
MAC_OLLAMA_MODEL=gemma4:26b
# Timeout for the reachability probe. Keep it short — this is the thing that
# makes an absent Mac cheap. Raise it only if the LAN is genuinely slow.
MAC_OLLAMA_PROBE_TIMEOUT_MS=1500
# Timeout for actual generation. A 26B model on a laptop is not fast, and the
# first request after a reboot pays the cold model-load cost on top.
MAC_OLLAMA_TIMEOUT_MS=120000
# Sent to Ollama as keep_alive on every tier-0 request, and also parsed to infer
# whether the model is still resident (so the chat does not claim to be "warming
# up" a model that is already loaded). Accepts Ollama's forms: -1 = never evict,
# 0 = unload immediately, "30m"/"2h", or a bare number of seconds.
# -1 trades ~18GB of held memory for no cold starts. Idle cost is memory, not
# power: a resident model uses no GPU until it is actually inferring.
MAC_OLLAMA_KEEP_ALIVE=-1

# Tier 0 circuit breaker. Separate from the OpenAI breaker (CB_* below) on
# purpose: an absent Mac must not consume OpenAI's failure budget, and a flaky
# OpenAI must not stop us using the Mac. Tuned twitchier and with a much longer
# cooldown than OpenAI's — a laptop that left the house will not come back
# within 60 seconds, so there is no point retrying on that timescale.
MAC_CB_FAILURE_THRESHOLD=2
MAC_CB_COOLDOWN_MS=300000
MAC_CB_PROBE_COUNT=1

# ─── Tier 1: OpenAI ──────────────────────────────────────────────────────────
# Leave unset to run on the local tiers only.
OPENAI_API_KEY=sk-...
# gpt-4o-mini is the safe default for a public, unauthenticated endpoint: worst
# case per IP is now bounded by QUESTION_QUOTA_MAX (below), so a stronger model
# is a reasonable, low-risk upgrade if you want it — it's a one-line change
# here, not a code change.
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Timeout for OpenAI requests in milliseconds (default: 30000)
OPENAI_TIMEOUT_MS=30000

# Tier 1 circuit breaker (guards the OpenAI provider; see MAC_CB_* for tier 0)
# Number of consecutive transient failures before the breaker opens (default: 5)
CB_FAILURE_THRESHOLD=5
# Milliseconds to wait in the open state before probing OpenAI again (default: 60000)
CB_COOLDOWN_MS=60000
# Number of successful probe requests needed to close the breaker (default: 1)
CB_PROBE_COUNT=1

# ─── Tier 2: local Ollama fallback ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Optional request timeout in ms. 0 (the default) means no timeout, which is
# the historical behaviour for this tier.
OLLAMA_TIMEOUT_MS=0

# Rate limiting — bursts (requests/minute)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Question quota — sustained cost cap, separate from the rate limiter above.
# Caps total on-topic (non off-topic) questions per IP within the window; the
# final allowed answer gets a LinkedIn CTA appended, further questions in the
# window are declined before any LLM call. Session id used for conversation
# memory (SESSION_TTL_MS below) is not part of this boundary — it's IP-keyed
# on purpose. See src/lib/questionQuota.ts.
QUESTION_QUOTA_MAX=5
QUESTION_QUOTA_WINDOW_MS=86400000

# How long a conversation's recent turns (last 3) are kept in memory to give
# follow-up questions context, in milliseconds (default: 30 minutes). This is
# UX only, not a security boundary — see src/lib/session.ts.
SESSION_TTL_MS=1800000

# Logging — JSON logs are written to a daily-rotated file in LOG_DIR (and also
# to stdout). Old files are gzipped and pruned per LOG_MAX_FILES.
LOG_DIR=logs
LOG_LEVEL=info
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# Pushover notifications (https://pushover.net/api). When both vars are set,
# every Q&A iteration sends a friendly summary push (time, question, success,
# duration, LLMs used). Leave unset to disable.
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
PUSHOVER_TIMEOUT_MS=5000
# Minimum gap between two alerts of the same kind. Alerts fire on exceptional
# pipeline events (a tier's breaker opening or recovering, a stream dying
# mid-answer, every tier failing at once). Throttled because a tier that stays
# down re-opens its breaker on every probe cycle.
PUSHOVER_ALERT_MIN_INTERVAL_MS=3600000

# ─── Scheduled profile refresh (src/lib/refresh/, npm run refresh:profile) ────
# Pulls from GitHub, Spotify and Apple Music and proposes updates to data/.
# Writes proposals to data/proposals/ — it does not touch data/ unless run with
# `-- --apply`. See docs/profile-refresh-plan.md for the design and the reasons.

# Which adapters run. Comma list; omit for all three. Disabling a source that
# started failing is an env edit rather than a deploy.
# REFRESH_SOURCES=github,spotify,appleMusic

# Models for the two stages. Stage A reads untrusted third-party text behind a
# JSON schema; stage B edits the profile and never sees that text.
#
# Both default to MAC_OLLAMA_MODEL, and that default matters: naming a different
# model makes Ollama EVICT the resident one to load it, so the next visitor to
# the live site pays a cold start of tens of seconds. That cost shows up on the
# website, not in this job's logs. Override only for a run scheduled at an hour
# when nobody is reading.
# REFRESH_EXTRACT_MODEL=gemma4:26b
# REFRESH_EDIT_MODEL=gemma4:31b

# Whether a run may fall back to OpenAI when the Mac is away. Deliberately the
# opposite of the answer path's policy: the fallback chain exists so a *visitor*
# never waits on a sleeping laptop, and a batch job has no visitor. If the Mac
# isn't home the right answer is to skip and run again tomorrow, not to bill a
# paid provider for a background crawl.
REFRESH_ALLOW_PAID_FALLBACK=false

# Generation timeout per model call. Longer than the answer path — nobody is
# watching this one stream.
REFRESH_TIMEOUT_MS=180000

# GitHub — public API. Works with no token at 60 req/h; a classic PAT with only
# `public_repo` raises that to 5000/h. Repos are read from their default branch.
GITHUB_USER=davittatenkohayrapetyan
# GITHUB_TOKEN=ghp_...

# Spotify — Client Credentials flow (app-level, no user login, no scopes) from a
# free app at developer.spotify.com. Without these the adapter reports
# `not_configured` and the run continues; Apple Music needs no key at all.
# Note that monthly listeners are NOT available from the Web API — that figure
# exists only in Spotify for Artists, so music.json keeps it as a hand-entered
# stat with an `asOf` date and this job leaves it alone.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
SPOTIFY_ARTIST_ID=4G26tr9xqGvtZa9B0qboob

# Apple Music — uses the keyless iTunes Lookup API rather than the Apple Music
# API, which would require a paid Apple Developer membership and a signed JWT
# for the same public release list. The id is the trailing number in a Music
# URL: https://music.apple.com/us/artist/shepard-d/1576499552
APPLE_MUSIC_ARTIST_ID=1576499552

# ─── Admin review UI (/login -> /admin) ──────────────────────────────────────
# Gates write access to data/ — the content every answer on the public site is
# generated from. Someone who gets through here does not deface a page, they
# change what the assistant tells recruiters about Davit. Treat it accordingly.
#
# Kept in .env rather than in source on purpose: a password committed to git
# cannot be un-published, and rotating this should be an env edit plus a
# restart, not a commit plus a rebuild.
ADMIN_PASSWORD=change-me

# HMAC key for the session cookie. If unset, a random key is generated per
# process — which means sessions silently stop working across a restart or a
# second replica. Set it in any real deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_SESSION_SECRET=

# Base URL used to build the review link in the Pushover notification. A
# notification whose only action is "go and find it yourself" gets postponed,
# and postponed review is the failure this workflow exists to prevent.
PUBLIC_BASE_URL=https://davithayrapetyan.dev

# ─── SoundCloud (profile refresh source) ─────────────────────────────────────
# The mobile host is accepted and normalised before the oEmbed call.
SOUNDCLOUD_PROFILE_URL=https://soundcloud.com/shepard-d
# Optional. SoundCloud closed developer registration years ago, so most setups
# will not have a client id. Without one the adapter still returns the profile
# via the keyless public oEmbed endpoint — just no track list. Reading the track
# list off the page instead was declined for the same reason LinkedIn and
# Instagram were: it is scraping, and the account it risks is Davit's own.
# SOUNDCLOUD_CLIENT_ID=

# ─── Display timezone ────────────────────────────────────────────────────────
# Timezone for timestamps a human reads: Pushover notifications and the refresh
# run report. Structured logs stay in UTC, deliberately — they are correlated
# across machines and read by tooling, and a log line in local time is one you
# cannot line up with anything.
#
# An IANA zone name, not a fixed offset. Armenia has had no DST since 2012 so
# the two are identical today, but "+04:00" encodes an assumption a government
# decision could invalidate, and it would fail in the least visible way there
# is: timestamps quietly an hour out in notifications nobody cross-checks.
DISPLAY_TIMEZONE=Asia/Yerevan

# ─── Scheduled job outreach (src/lib/outreach/, npm run outreach) ─────────────
# Finds roles workable from Yerevan — remote, or in the local office of an
# international company — and, from phase 3 onwards, scores and drafts them.
# Nothing is ever sent without Davit approving it. See docs/job-outreach-plan.md
# for the design; §15 there lists the variables the later phases add.
#
# Only the variables the code actually honours today are listed here. A
# documented variable that nothing reads is worse than an undocumented one: it
# gets set, and then it gets trusted.

# Which adapters run. Comma list; omit for every implemented source. All nine
# the plan names exist as of phase 2, so the full list can be pasted in as it
# stands; a watch-list company on an ATS with no adapter (Eightfold) is reported
# as `not_implemented` rather than silently doing nothing.
# OUTREACH_SOURCES=workday,pinpoint,greenhouse,lever,ashby,remotive,remoteok,arbeitnow,himalayas

# Upper bound on postings pulled into memory in one run. A guard against an
# adapter that starts returning a whole board rather than a filtered slice, not
# a tuning knob — the run's real bound is its 09:00 deadline (phase 2).
# OUTREACH_MAX_POSTINGS_PER_RUN=300

# Server-side search terms for Workday boards, one request each.
#
# Workday filters on a posting's whole location set, including the additional
# locations a multi-site requisition carries — which is why `Armenia` alone
# surfaces NVIDIA's Munich role, whose remote locations include Armenia. Two
# geographic terms therefore cover both families this job cares about: a Yerevan
# office role, and a global remote role that happens to accept Armenia.
#
# Role words can be added, but each term is another request against a board
# behind Akamai bot management, and a role word mostly returns postings the geo
# filter drops. Start narrow; widen when a morning is provably too quiet.
# OUTREACH_WORKDAY_SEARCH_TERMS=Armenia,Yerevan

# ── The 08:00 window (§11) ────────────────────────────────────────────────────

# When the run stops, as a local wall clock in DISPLAY_TIMEZONE. A time, not a
# duration, and the difference is the point: Task Scheduler catches up a missed
# 08:00 start, so a run that begins at 08:40 should still be over before the
# working day rather than getting a full hour from whenever it woke up.
#
# A deadline already in the past — a run started by hand in the afternoon — is
# dropped, logged, and the duration budget below governs alone.
# OUTREACH_RUN_DEADLINE=09:00

# Belt and braces for that manual run. Bounds nothing the scheduled run does.
# OUTREACH_RUN_BUDGET_MS=3600000

# Queue-worthy postings after which the run stops early. Only `draft` and
# `surface_only` verdicts count, so a morning of 200 junior React postings
# cannot "find its matches" and stop before reaching anything real.
#
# Ten is a ceiling, not a target. The first full scored run reached three
# queue-worthy postings in 58 minutes out of 42 scored — most of a real ATS
# board is roles Davit would never take — so at that ratio the deadline runs out
# long before the count does. This stops a freak morning from queueing forty
# cards and otherwise stays out of the way.
# OUTREACH_STOP_AFTER_MATCHES=10

# How long a cached aggregator feed stays fresh. 90 minutes is what lets the
# 07:00 company-discovery run hand its reads to the 08:00 opportunity run: the
# feeds do not meaningfully change in an hour, and the second job then spends
# its time on the Mac rather than on HTTP. Only aggregator GETs are cached —
# never a Workday POST, because replaying a request to a bot-managed endpoint is
# meaningless to it and dishonest of us.
# OUTREACH_CACHE_TTL_MS=5400000

# Rows taken from one aggregator feed per run. Bounds the work the geo filter
# and the report do, not the number of requests — these boards hand over their
# whole front page in one call, and Arbeitnow's is 250 postings and 2 MB.
# OUTREACH_AGGREGATOR_PAGE_LIMIT=100

# Pages of the Himalayas feed to walk. Alone among the four it caps `limit` at
# 20 and pages by cursor, so one call is 20 postings. Three pages is the newest
# 60, which is the slice a daily run can act on; deeper is yesterday's feed,
# which yesterday's run already read.
# OUTREACH_HIMALAYAS_PAGES=3

# ── Scoring: stage A and stage B (§4, §7) ─────────────────────────────────

# Which model reads postings and which one judges them. Leave both empty.
#
# Empty means "whatever the site is already running", and that is the right
# default rather than laziness: naming a different model makes Ollama evict the
# resident one, so the next visitor to the website pays a cold start of tens of
# seconds. That cost lands on the site, not in this job's logs — which is
# exactly the kind of cost that goes unnoticed.
# OUTREACH_EXTRACT_MODEL=
# OUTREACH_SCORE_MODEL=
# OUTREACH_DRAFT_MODEL=

# Whether a stage may fall back to OpenAI when the Mac is away. Off, same
# argument as the refresh job: the fallback chain exists so a *visitor* never
# waits on a sleeping laptop, and a batch job has no visitor. A run with no
# model still produces a queue — unscored, with real links — which is worth
# more than a surprise invoice.
# OUTREACH_ALLOW_PAID_FALLBACK=false

# Per-call timeout. Generous, because the first call after the Mac has been idle
# pays for loading the model, and a timeout that fires during a cold load turns
# a slow morning into an empty one.
# OUTREACH_TIMEOUT_MS=180000

# §7: a role in Yerevan is never auto-drafted, whatever it scores. Not because
# those roles are worse — the Align Sr. Java Engineer is the best match this
# design has found — but because the decision behind them is a different size,
# and it is the family where an auto-sent application is most likely to reach
# someone Davit will meet in person. The override lives in `score.ts` as code,
# never as prompt wording; this only turns it off, deliberately and visibly.
# OUTREACH_LOCAL_ALWAYS_SURFACE=true

# How long a queued posting waits for a decision. Expiry is not a decision and
# never becomes one: nothing is ever recorded as applied because it timed out.
# OUTREACH_QUEUE_TTL_DAYS=21

# ── Review and the applied ledger (§8, §8.1) ───────────────────────────────

# Nothing is transmitted while this is true, and it is true unless something
# deliberately says otherwise. Not caution theatre: the first bug in a system
# that emails strangers should be found in a log file. Only the exact string
# `false` turns it off, so a typo or an empty value still means "do not send".
#
# While it is on, approving a role in /admin writes the ledger with a `dryRun`
# marker and sends nothing — which exercises every guard around the send
# without there being a send.
# OUTREACH_DRY_RUN=true

# Applications transmitted in one local day. A new sending domain that mails
# fifty strangers on day one has a deliverability problem by day two, and the
# reputation being spent belongs to the same domain the portfolio site runs on.
# Enforced where the sending happens, never in the UI.
# OUTREACH_MAX_SENDS_PER_DAY=5

# The per-company cooldown: the difference between a duplicate and spam. Five
# applications to five companies is a good morning; five to one company is a
# pattern a recruiter notices, and they all land with the same ATS and often
# the same reviewer. "Not interested" never consumes this — saying no to one
# bad role at NVIDIA must not block a good one for a month.
# OUTREACH_MAX_APPLICATIONS_PER_COMPANY=1
# OUTREACH_COMPANY_COOLDOWN_DAYS=30

# Days after which the same role may be applied to again. 0 means never: a role
# reposted six months later is still the same role at the same company, so
# raising this is a deliberate act rather than a tuning decision.
# OUTREACH_REAPPLY_AFTER_DAYS=0

# Days before an unconfirmed form handoff comes back asking. A human clicks
# Submit on the host, so the ledger only learns about it if told — and guessing
# either way is worse than asking: assume sent and a good role is silently
# dropped, assume not and the system may duplicate a real application.
# OUTREACH_FORM_CONFIRM_AFTER_DAYS=3
