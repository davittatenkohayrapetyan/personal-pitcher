# LLM_PROVIDER is no longer used by the default provider. The system now always
# tries OpenAI first (when OPENAI_API_KEY is set) and falls back to Ollama.
# This variable is kept for reference; createLLMProvider() still accepts it for
# direct single-provider usage if needed.
# LLM_PROVIDER=ollama

# Ollama settings (local Llama fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI settings (primary provider; leave unset to use Ollama only)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Timeout for OpenAI requests in milliseconds (default: 30000)
OPENAI_TIMEOUT_MS=30000

# Circuit breaker settings (guards the OpenAI provider)
# Number of consecutive transient failures before the breaker opens (default: 5)
CB_FAILURE_THRESHOLD=5
# Milliseconds to wait in the open state before probing OpenAI again (default: 60000)
CB_COOLDOWN_MS=60000
# Number of successful probe requests needed to close the breaker (default: 1)
CB_PROBE_COUNT=1

# Rate limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
