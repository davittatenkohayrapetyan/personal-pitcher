{
  "note": "Hand-written stage-A cases for the sanitiser drill (section 19.2). Run with `npm run outreach -- --posting-fixtures`. Each case is a posting plus what a model returned about it, so the whole chain from model output to ExtractedPosting can be exercised with no Mac, no network and no tokens. The four the plan names are here — a US-only remote, a Yerevan on-site, a bare Remote, and the injection — plus the grounding and enum cases that decide whether a posting is quietly wrong rather than loudly refused, and the regression that matters most: ordinary senior-posting prose (\"act as the technical owner\", \"own the system message bus\") trips three of the injection rules, and must lose the clause rather than the posting.",
  "cases": [
    {
      "name": "US-only remote — extracted cleanly, quoted fields grounded",
      "posting": {
        "source": "remotive",
        "key": "us-only-1",
        "company": "Northwind Systems",
        "title": "Staff Backend Engineer",
        "url": "https://northwind.example/jobs/staff-backend",
        "locationText": "USA",
        "untrusted": {
          "description": "Staff Backend Engineer. Remote — US only. You must be legally authorized to work in the United States; we do not sponsor visas. Our stack is Java, Kotlin, PostgreSQL and Kafka. You will own the payments platform and mentor three engineers. Base salary $180,000 - $210,000. Apply at careers@northwind.example."
        },
        "structured": {}
      },
      "model": {
        "key": "us-only-1",
        "title": "Staff Backend Engineer",
        "company": "Northwind Systems",
        "seniority": "staff",
        "engagement": "employee",
        "workMode": "remote",
        "officeLocation": "",
        "geoRestriction": "Remote — US only",
        "timezoneRequirement": "",
        "stack": [
          "Java",
          "Kotlin",
          "PostgreSQL",
          "Kafka"
        ],
        "responsibilities": [
          "own the payments platform",
          "mentor three engineers"
        ],
        "compensation": "$180,000 - $210,000",
        "applyMethod": "email",
        "applyTarget": "careers@northwind.example"
      },
      "expect": {
        "ok": true,
        "rules": [],
        "fields": {
          "geoRestriction": "Remote — US only",
          "compensation": "$180,000 - $210,000",
          "applyTarget": "careers@northwind.example",
          "stackCount": 4
        }
      }
    },
